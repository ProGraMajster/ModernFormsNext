<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>ModernFormsNext.Designing</PackageId>
    <Version>$(ModernFormsNextPackageVersion)</Version>
    <Authors>ProGraMajster</Authors>
    <Company>ModernFormsNext</Company>
    <Product>ModernFormsNext.Designing</Product>
    <Copyright>Copyright (c) 2026 ProGraMajster</Copyright>
    <Description>Neutral document model, serialization, validation, metadata, and designer services for ModernFormsNext design documents.</Description>
    <PackageTags>ui;designer;forms;skia;desktop;framework;modernforms;mfdesign</PackageTags>
    <RepositoryUrl>https://github.com/ProGraMajster/ModernFormsNext</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ProGraMajster/ModernFormsNext</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
