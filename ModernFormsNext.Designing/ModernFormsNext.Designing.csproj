<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ModernFormsNext.Designing</PackageId>
    <Title>ModernFormsNext Designing</Title>
    <Version>$(ModernFormsNextPackageVersion)</Version>
    <Product>ModernFormsNext.Designing</Product>
    <Description>Neutral document model, serialization, validation, metadata, and designer services for ModernFormsNext design documents.</Description>
    <PackageTags>ui;designer;forms;skia;desktop;framework;modernforms;mfdesign</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
