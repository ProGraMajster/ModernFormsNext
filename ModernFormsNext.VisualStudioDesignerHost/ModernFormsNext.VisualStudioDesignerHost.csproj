<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ModernFormsNext.VisualStudioDesignerHost</AssemblyName>
    <RootNamespace>ModernFormsNext.VisualStudioDesignerHost</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>$(ModernFormsNextPackageVersion)</Version>
    <Authors>ProGraMajster</Authors>
    <Company>ModernFormsNext</Company>
    <Product>ModernFormsNext.VisualStudioDesignerHost</Product>
    <Copyright>Copyright (c) 2026 ProGraMajster</Copyright>
    <Description>Out-of-process ModernFormsNext designer host launched by the Visual Studio extension.</Description>
    <RepositoryUrl>https://github.com/ProGraMajster/ModernFormsNext</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernFormsNext\ModernFormsNext.csproj" />
    <ProjectReference Include="..\ModernFormsNext.Designer\ModernFormsNext.Designer.csproj" />
    <ProjectReference Include="..\ModernFormsNext.Designing\ModernFormsNext.Designing.csproj" />
  </ItemGroup>

</Project>
