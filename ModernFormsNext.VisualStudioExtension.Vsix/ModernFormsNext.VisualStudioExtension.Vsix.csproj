<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>$(ModernFormsNextVisualStudioExtensionVersion)</Version>
    <AssemblyVersion>$(ModernFormsNextVisualStudioExtensionVersion).0</AssemblyVersion>
    <FileVersion>$(ModernFormsNextVisualStudioExtensionVersion).0</FileVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>ModernFormsNext.VisualStudioExtension</AssemblyName>
    <RootNamespace>ModernFormsNext.VisualStudioExtension</RootNamespace>
    <Product>ModernFormsNext.VisualStudioExtension</Product>
    <Description>Visual Studio designer support for ModernFormsNext .mfdesign files.</Description>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <TargetVsixContainerName>ModernFormsNextDesigner.vsix</TargetVsixContainerName>
    <VSSDKBuildToolsVersion>17.14.2142</VSSDKBuildToolsVersion>
    <UseCodebase>true</UseCodebase>
    <DesignerHostProject>..\ModernFormsNext.VisualStudioDesignerHost\ModernFormsNext.VisualStudioDesignerHost.csproj</DesignerHostProject>
    <DesignerHostPublishDir>$(IntermediateOutputPath)DesignerHost\</DesignerHostPublishDir>
    <DesignerHostRuntimeIdentifier>win-x64</DesignerHostRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The VSIX project publishes the out-of-process designer host while the
      solution is often rebuilt in parallel by Visual Studio. These build-order
      references make the dependency graph explicit so the packaging project
      cannot publish the host while its ModernFormsNext/backend references are
      still being cleaned or rebuilt. The outputs are not referenced by this
      net472 package assembly; they are only build dependencies.
    -->
    <ProjectReference Include="..\ModernFormsNext.VisualStudioExtension\ModernFormsNext.VisualStudioExtension.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\ModernFormsNext.VisualStudioDesignerHost\ModernFormsNext.VisualStudioDesignerHost.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ItemTemplates\**\*.cs" />
    <None Remove="ItemTemplates\**\*" />
    <Content Include="ItemTemplates\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\%(RecursiveDir)</VSIXSubPath>
    </Content>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <VSCTCompile Include="ModernFormsNext.VisualStudioExtension.vsct" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Import Project="$(NuGetPackageRoot)microsoft.vssdk.buildtools\$(VSSDKBuildToolsVersion)\tools\vssdk\Microsoft.VsSDK.targets"
          Condition="Exists('$(NuGetPackageRoot)microsoft.vssdk.buildtools\$(VSSDKBuildToolsVersion)\tools\vssdk\Microsoft.VsSDK.targets')" />

  <Target Name="CreateModernFormsNextVsixAfterBuild"
          AfterTargets="Build"
          DependsOnTargets="GeneratePkgDef;CopyPkgDef;CreateVsixContainer"
          Condition="'$(DesignTimeBuild)' != 'true'" />

  <Target Name="SyncModernFormsNextVsixManifest"
          BeforeTargets="CreateVsixContainer"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <!--
      VSSDK packs extension.vsixmanifest from the intermediate/output folder.
      Keep it in lockstep with the editable source manifest so repeated local
      builds cannot package a stale InstallationTarget or version.
    -->
    <Delete Files="$(TargetDir)$(TargetVsixContainerName);$(IntermediateOutputPath)extension.vsixmanifest;$(OutputPath)extension.vsixmanifest" />
    <Copy SourceFiles="source.extension.vsixmanifest"
          DestinationFiles="$(IntermediateOutputPath)extension.vsixmanifest"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="source.extension.vsixmanifest"
          DestinationFiles="$(OutputPath)extension.vsixmanifest"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="ValidateModernFormsNextVsix"
          AfterTargets="CreateVsixContainer"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Validate-Vsix.ps1&quot; -VsixPath &quot;$(TargetDir)$(TargetVsixContainerName)&quot; -ExpectedVersion &quot;$(ModernFormsNextVisualStudioExtensionVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

  <Target Name="PublishModernFormsNextDesignerHost"
          BeforeTargets="GetVsixSourceItems"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(DesignerHostPublishDir)" />
    <MSBuild Projects="$(DesignerHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=$(DesignerHostRuntimeIdentifier);PublishDir=$(MSBuildProjectDirectory)\$(DesignerHostPublishDir);SelfContained=false;EnableWindowsTargeting=true" />
    <ItemGroup>
      <ModernFormsNextDesignerHostFile Include="$(DesignerHostPublishDir)**\*" />
      <Content Include="@(ModernFormsNextDesignerHostFile)">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>DesignerHost\%(ModernFormsNextDesignerHostFile.RecursiveDir)</VSIXSubPath>
      </Content>
    </ItemGroup>
  </Target>
</Project>
