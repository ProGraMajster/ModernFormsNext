<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<PackageId>ModernFormsNext.Templates</PackageId>
		<Version>$(ModernFormsNextPackageVersion)</Version>
		<Title>ModernFormsNext Templates</Title>
		<Product>ModernFormsNext.Templates</Product>
		<Description>Project templates for ModernFormsNext.</Description>
		<PackageTags>ModernFormsNext;Templates;dotnet-new;CSharp;Desktop;UI;Windows</PackageTags>
		<PackageType>Template</PackageType>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>

		<IncludeSymbols>false</IncludeSymbols>

		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Keep generated build and IDE state out of the user-facing template even when
		     contributors restore or build the template source in place before packing. -->
		<Content Include="templates\**\*"
		         Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\*.user;templates\**\*.suo;templates\**\*.tmp;templates\**\*.cache"
		         Pack="true"
		         PackagePath="content" />
		<!-- Template source files are packaged as content and must not be compiled into the template package assembly. -->
		<Compile Remove="templates\**\*.cs" />
		<Content Include="README.md" Pack="true" PackagePath="\" />
		<Content Include="..\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
	</ItemGroup>

</Project>
