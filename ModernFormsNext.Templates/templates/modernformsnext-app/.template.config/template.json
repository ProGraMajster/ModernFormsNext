{
  "$schema": "http://json.schemastore.org/template",
  "author": "ProGraMajster",
  "classifications": [
    "Desktop",
    "UI",
    "ModernFormsNext",
    "Windows"
  ],
  "identity": "ProGraMajster.ModernFormsNext.Templates.App",
  "groupIdentity": "ProGraMajster.ModernFormsNext.Templates",
  "name": "ModernFormsNext App",
  "shortName": "mfn-app",
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "description": "Creates a minimal ModernFormsNext desktop application.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "FrameworkVersion": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0-windows",
      "description": "Target framework for the generated ModernFormsNext application.",
      "choices": [
        {
          "choice": "net10.0-windows",
          "description": "Recommended Windows desktop target."
        },
        {
          "choice": "net10.0",
          "description": "Platform-neutral target. Use only when the selected backend supports it."
        }
      ],
      "replaces": "net10.0-windows"
    }
  },
  "primaryOutputs": [
    {
      "path": "MyApp.csproj"
    }
  ]
}