<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.modernformsnext.skiaqualification</ApplicationId>
    <ApplicationTitle>ModernFormsNext Skia Qualification</ApplicationTitle>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TextCorpus.cs" Link="TextCorpus.cs" />
    <ProjectReference Include="../../../../../ModernFormsNext/ModernFormsNext.csproj" />
    <ProjectReference Include="../../../../../ModernFormsNext.WindowKit.Backend.Android/ModernFormsNext.WindowKit.Backend.Android.csproj" />
    <!-- Match the sample's Android-specific HarfBuzz closure. -->
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpPackageVersion)" />
  </ItemGroup>
</Project>
