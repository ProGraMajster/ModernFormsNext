    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(ResourceLegacyDiagnostic)' == 'true'">$(DefineConstants);LEGACY_RESOURCE_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../ModernFormsNext/ModernFormsNext.csproj" />
  </ItemGroup>
</Project>
