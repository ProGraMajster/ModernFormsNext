<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>$(ModernFormsNextVisualStudioExtensionVersion)</Version>
    <Product>ModernFormsNext.VisualStudioExtension</Product>
    <Description>Visual Studio designer integration for ModernFormsNext .mfdesign files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="ModernFormsNext.VisualStudioExtension.vsct" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernFormsNext.WindowKit.Backend.Windows\ModernFormsNext.WindowKit.Backend.Windows.csproj" />
    <ProjectReference Include="..\ModernFormsNext.Designer\ModernFormsNext.Designer.csproj" />
    <ProjectReference Include="..\ModernFormsNext.Designing\ModernFormsNext.Designing.csproj" />
    <ProjectReference Include="..\ModernFormsNext.CodeGeneration\ModernFormsNext.CodeGeneration.csproj" />
  </ItemGroup>

</Project>
