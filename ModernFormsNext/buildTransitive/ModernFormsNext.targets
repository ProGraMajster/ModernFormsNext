<Project>
  <!--
    Visual Studio reads DependentUpon from evaluated project items. Apply the conventional
    ModernFormsNext three-file relationship from the package so existing SDK-style projects do
    not need hand-written project-file edits merely to display Designer companions correctly.
    Explicit user/project metadata remains authoritative.
  -->
  <ItemGroup>
    <Compile Update="**/*.Designer.cs">
      <DependentUpon Condition="'%(DependentUpon)' == '' and Exists('$([System.String]::Copy(&quot;%(FullPath)&quot;).Replace(&quot;.Designer.cs&quot;, &quot;.mfdesign&quot;))')">$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon>
    </Compile>
    <None Update="**/*.mfdesign">
      <DependentUpon Condition="'%(DependentUpon)' == '' and Exists('$([System.IO.Path]::ChangeExtension(&quot;%(FullPath)&quot;, &quot;.cs&quot;))')">%(Filename).cs</DependentUpon>
    </None>
  </ItemGroup>
  <!-- The reserved folders are enabled explicitly so existing projects keep their own item rules. -->
  <ItemGroup Condition="'$(ModernFormsNextUseProjectAssets)' == 'true'">
    <Compile Remove="Assets/Embedded/**/*;Assets/Content/**/*" />
    <None Remove="Assets/Embedded/**/*;Assets/Content/**/*" />
    <EmbeddedResource Remove="Assets/Embedded/**/*;Assets/Content/**/*" />
    <Content Remove="Assets/Embedded/**/*;Assets/Content/**/*" />
    <EmbeddedResource Include="Assets/Embedded/**/*" Exclude="Assets/Embedded/**/.import-*.tmp">
      <LogicalName>Assets/Embedded/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
      <Type>Non-Resx</Type>
    </EmbeddedResource>
    <Content Include="Assets/Content/**/*" Exclude="Assets/Content/**/.import-*.tmp">
      <TargetPath>Assets/Content/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
