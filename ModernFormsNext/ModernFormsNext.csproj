<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		

		<PackageId>ModernFormsNext</PackageId>
		<Title>ModernFormsNext</Title>
		<Version>$(ModernFormsNextPackageVersion)</Version>
		<Product>ModernFormsNext</Product>
		<Description>ModernFormsNext is a modern high-performance UI framework inspired by WinForms, powered by SkiaSharp. Designed for speed, flexibility and full control over rendering.</Description>
		<PackageTags>ui;winforms;skia;desktop;framework;modernforms</PackageTags>
	</PropertyGroup>

	<!-- Assets -->
	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
	</ItemGroup>

	<!-- BindingNavigator still depends on WinForms ToolStrip concepts and needs a ModernFormsNext-native port. -->
	<ItemGroup>
		<Compile Remove="DataBinding\BindingNavigator.cs" />
	</ItemGroup>

	<!-- External -->
	<ItemGroup>
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Topten.RichTextKit" Version="0.4.167" />
	</ItemGroup>

	<!-- Internal projects -->
	<ItemGroup>
		<ProjectReference Include="..\ModernFormsNext.WindowKit\ModernFormsNext.WindowKit.csproj" />
		<ProjectReference Include="..\ModernFormsNext.WindowKit.Backend\ModernFormsNext.WindowKit.Backend.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
		<ProjectReference Include="..\ModernFormsNext.WindowKit.Backend.Windows\ModernFormsNext.WindowKit.Backend.Windows.csproj" />
	</ItemGroup>

	<!-- 
	<ItemGroup Condition="'$(Configuration)' != 'Release'"> 
		<ProjectReference Include="..\ModernFormsNext.WindowKit\ModernFormsNext.WindowKit.csproj" />
