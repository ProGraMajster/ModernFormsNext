		<ProjectReference Include="..\ModernFormsNext.WindowKit.Backend.Windows\ModernFormsNext.WindowKit.Backend.Windows.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="ModernFormsNext.WindowKit" Version="$(ModernFormsNextPackageVersion)" />
